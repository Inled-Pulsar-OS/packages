{
  "id": "sayri-gateway-telegram",
  "name": "Telegram Bot Gateway",
  "version": "1.1.0",
  "author": "jaimegh-es",
  "description": "Autonomous Telegram Bot Gateway bridging external chat messages to Sayri with Desktop OTP pairing and whitelist authorization.",
  "entrypoint": "gateway.py",
  "sandbox_level": "LEVEL_1_READONLY",
  "required_secrets": [
    "TELEGRAM_BOT_TOKEN"
  ],
  "authorization": {
    "mode": "pairing_otp",
    "allowed_users": [],
    "pairing_pin_required": true,
    "pin_expiration_seconds": 300,
    "rate_limit": {
      "max_requests_per_minute": 15,
      "burst": 3
    }
  },
  "ui": {
    "sync_instructions": "1. Open Telegram and search for your bot.\n2. Send /start to request access.\n3. Enter the 6-digit PIN shown on this desktop screen or click 'Show Pairing PIN'.",
    "chat_url": "https://t.me/sayri_pulsaros_bot",
    "actions": [
      {
        "id": "set_token",
        "label": "Configure Bot Token",
        "type": "secret_prompt",
        "secret_key": "TELEGRAM_BOT_TOKEN"
      },
      {
        "id": "view_pin",
        "label": "Show Pairing PIN",
        "type": "display_pin"
      }
    ]
  },
  "capabilities": [
    "receive_messages",
    "send_replies",
    "voice_audio_stream"
  ],
  "allowed_domains": [
    "api.telegram.org"
  ]
}
